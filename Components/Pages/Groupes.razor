@page "/groupes"
@rendermode InteractiveServer
@inject HttpClient Http

<div class="sk-page-header">
    <h2 class="sk-page-title">Gestion des groupes</h2>
    <p class="sk-page-sub">Ajouter, modifier ou supprimer les groupes associés aux programmes.</p>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="sk-alert sk-alert-warning">@message</div>
}

<!-- Formulaire ajout -->
<div class="sk-card" style="margin-bottom:24px;">
    <div class="sk-section-title" style="margin-bottom:16px;">➕ Ajouter un groupe</div>
    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
        <div class="sk-form-group" style="flex:1; min-width:200px; margin:0;">
            <label>Nom du groupe</label>
            <input class="sk-input" @bind="newGroupe.Nom" placeholder="Ex: Groupe A" />
        </div>
        <div class="sk-form-group" style="flex:1; min-width:200px; margin:0;">
            <label>Programme</label>
            <select class="sk-input" @bind="newGroupe.IdProgramme">
                <option value="0">Choisir un programme</option>
                @if (programmes != null)
                {
                    @foreach (var p in programmes)
                    {
                        <option value="@p.IdProgramme">@p.Nom</option>
                    }
                }
            </select>
        </div>
        <button class="sk-btn sk-btn-primary" @onclick="Ajouter" style="margin-bottom:0;">
            Ajouter
        </button>
    </div>
</div>

<!-- Liste des groupes -->
<div class="sk-card">
    <div class="sk-section-title" style="margin-bottom:16px;">📋 Liste des groupes</div>
    @if (groupes == null)
    {
        <div class="sk-loading">Chargement...</div>
    }
    else if (groupes.Count == 0)
    {
        <div class="sk-empty">Aucun groupe trouvé.</div>
    }
    else
    {
        <div class="sk-table-wrapper">
            <table class="sk-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Programme</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in groupes)
                    {
                        <tr>
                            @if (editId == g.IdGroupe)
                            {
                                <td>@g.IdGroupe</td>
                                <td>
                                    <input class="sk-input" style="padding:4px 8px;" @bind="editGroupe.Nom" />
                                </td>
                                <td>
                                    <select class="sk-input" style="padding:4px 8px;" @bind="editGroupe.IdProgramme">
                                        @if (programmes != null)
                                        {
                                            @foreach (var p in programmes)
                                            {
                                                <option value="@p.IdProgramme">@p.Nom</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td class="sk-actions">
                                    <button class="sk-btn sk-btn-sm sk-btn-primary" @onclick="Sauvegarder">✔ Sauvegarder</button>
                                    <button class="sk-btn sk-btn-sm sk-btn-outline" @onclick="Annuler">Annuler</button>
                                </td>
                            }
                            else
                            {
                                <td style="color:#888; font-size:0.85rem;">@g.IdGroupe</td>
                                <td><strong>@g.Nom</strong></td>
                                <td>
                                    <span class="sk-badge sk-badge-info" style="font-size:0.8rem;">@GetNomProgramme(g.IdProgramme)</span>
                                </td>
                                <td class="sk-actions">
                                    <button class="sk-btn sk-btn-sm sk-btn-outline" @onclick="() => Modifier(g)">Modifier</button>
                                    <button class="sk-btn sk-btn-sm sk-btn-danger" @onclick="() => Supprimer(g.IdGroupe)">Supprimer</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    List<GroupeDto>? groupes;
    List<Programme>? programmes;

    GroupeDto newGroupe = new();
    GroupeDto editGroupe = new();

    int editId = -1;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        await Charger();

        programmes = await Http.GetFromJsonAsync<List<Programme>>("api/Programme");
    }

    async Task Charger()
    {
        groupes = await Http.GetFromJsonAsync<List<GroupeDto>>("api/Groupes");
    }

    async Task Ajouter()
    {
        message = "";

        if (string.IsNullOrWhiteSpace(newGroupe.Nom))
        {
            message = "Le nom du groupe est obligatoire.";
            return;
        }

        if (newGroupe.IdProgramme == 0)
        {
            message = "Veuillez choisir un programme.";
            return;
        }

        await Http.PostAsJsonAsync("api/Groupes", newGroupe);

        newGroupe = new GroupeDto();

        await Charger();
    }

    void Modifier(GroupeDto g)
    {
        editId = g.IdGroupe;

        editGroupe = new GroupeDto
        {
            IdGroupe = g.IdGroupe,
            Nom = g.Nom,
            IdProgramme = g.IdProgramme
        };
    }

    async Task Sauvegarder()
    {
        message = "";

        if (string.IsNullOrWhiteSpace(editGroupe.Nom))
        {
            message = "Le nom du groupe est obligatoire.";
            return;
        }

        if (editGroupe.IdProgramme == 0)
        {
            message = "Veuillez choisir un programme.";
            return;
        }

        await Http.PutAsJsonAsync($"api/Groupes/{editId}", editGroupe);

        editId = -1;

        await Charger();
    }

    void Annuler()
    {
        editId = -1;
        message = "";
    }

    async Task Supprimer(int id)
    {
        await Http.DeleteAsync($"api/Groupes/{id}");

        await Charger();
    }

    string GetNomProgramme(int idProgramme)
    {
        return programmes?
            .FirstOrDefault(p => p.IdProgramme == idProgramme)?
            .Nom ?? "N/A";
    }

    public class GroupeDto
    {
        public int IdGroupe { get; set; }

        public string Nom { get; set; } = "";

        public int IdProgramme { get; set; }
    }

    public class Programme
    {
        public int IdProgramme { get; set; }

        public string Nom { get; set; } = "";
    }
}
