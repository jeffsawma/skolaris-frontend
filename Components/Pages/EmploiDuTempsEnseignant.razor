@page "/enseignant/emploi-du-temps"
@rendermode InteractiveServer

@inject HttpClient Http
@inject IJSRuntime JS

<h3>Mon emploi du temps</h3>

@if (creneaux == null)
{
    <p>Chargement...</p>
}
else if (!creneaux.Any())
{
    <div class="alert alert-info">Aucun horaire publié pour le moment.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Jour</th>
                <th>Heure</th>
                <th>Cours</th>
                <th>Groupe</th>
                <th>Salle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in creneaux)
            {
                <tr>
                    <td>@Jour(c.jourSemaine)</td>
                    <td>@c.heureDebut - @c.heureFin</td>
                    <td>@c.coursNom</td>
                    <td>@c.groupeNom</td>
                    <td>@c.salle</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CreneauEnseignantDto>? creneaux;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var idUtilisateurString = await JS.InvokeAsync<string>("localStorage.getItem", "idUtilisateur");

            if (!int.TryParse(idUtilisateurString, out var idUtilisateur))
            {
                creneaux = new();
                StateHasChanged();
                return;
            }

            creneaux = await Http.GetFromJsonAsync<List<CreneauEnseignantDto>>(
                $"api/Creneaux/enseignant/{idUtilisateur}"
            ) ?? new();

            StateHasChanged();
        }
    }

    private string Jour(int jour) => jour switch
    {
        0 => "Lundi",
        1 => "Mardi",
        2 => "Mercredi",
        3 => "Jeudi",
        4 => "Vendredi",
        5 => "Samedi",
        _ => "Inconnu"
    };

    public class CreneauEnseignantDto
    {
        public int id { get; set; }
        public string coursNom { get; set; } = "";
        public string groupeNom { get; set; } = "";
        public int jourSemaine { get; set; }
        public string heureDebut { get; set; } = "";
        public string heureFin { get; set; } = "";
        public string? salle { get; set; }
    }
}