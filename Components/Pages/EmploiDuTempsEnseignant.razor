@page "/enseignant/emploi-du-temps"
@rendermode InteractiveServer

@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json

<h3>Mon emploi du temps</h3>

@if (creneaux == null)
{
    <p>Chargement...</p>
}
else if (!creneaux.Any())
{
    <div class="alert alert-info">
        Aucun horaire publié pour le moment.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Jour</th>
                <th>Heure</th>
                <th>Cours</th>
                <th>Groupe</th>
                <th>Salle</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var c in creneaux)
            {
                <tr>
                    <td>@c.jourSemaine</td>

                    <td>
                        @c.heureDebut - @c.heureFin
                    </td>

                    <td>@c.coursNom</td>

                    <td>@c.groupeNom</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(c.salle)
                                        ? "—"
                                        : c.salle)
            </td>
        </tr>
                }
        </tbody>
    </table>
}

@code {

    private List<CreneauEnseignantDto>? creneaux;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Récupère idUtilisateur du localStorage
                var idUtilisateurString =
                    await JS.InvokeAsync<string>(
                        "localStorage.getItem",
                        "idUtilisateur"
                    );

                // fallback userId
                if (string.IsNullOrWhiteSpace(idUtilisateurString))
                {
                    idUtilisateurString =
                        await JS.InvokeAsync<string>(
                            "localStorage.getItem",
                            "userId"
                        );
                }

                // Vérifie si id valide
                if (!int.TryParse(idUtilisateurString, out var idUtilisateur))
                {
                    creneaux = new();
                    StateHasChanged();
                    return;
                }

                // Charge les créneaux
                creneaux =
                    await Http.GetFromJsonAsync<List<CreneauEnseignantDto>>(
                        $"api/Creneaux/enseignant/{idUtilisateur}"
                    ) ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);

                // évite chargement infini
                creneaux = new();
            }

            StateHasChanged();
        }
    }

    public class CreneauEnseignantDto
    {
        public int id { get; set; }

        public string coursNom { get; set; } = "";

        public string groupeNom { get; set; } = "";

        // IMPORTANT : string et non int
        public string jourSemaine { get; set; } = "";

        public string heureDebut { get; set; } = "";

        public string heureFin { get; set; } = "";

        public string? salle { get; set; }
    }
}
