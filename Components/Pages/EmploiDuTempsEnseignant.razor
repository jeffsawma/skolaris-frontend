@page "/enseignant/emploi-du-temps"
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json

<h3>Mes creneaux</h3>
<p class="text-muted">Votre emploi du temps personnel.</p>

@if (creneaux == null)
{
    <p>Chargement...</p>
}
else if (!creneaux.Any())
{
    <div class="alert alert-info">Aucun creneau publie pour le moment.</div>
}
else
{
    <div class="d-flex gap-3 mb-3 align-items-center flex-wrap">
        <div class="card text-center px-3 py-2 border-success">
            <div class="fs-4 fw-bold text-success">@creneaux.Count</div>
            <div class="small text-muted">Seances</div>
        </div>
        <div class="card text-center px-3 py-2">
            <div class="fs-4 fw-bold">@TotalHeures</div>
            <div class="small text-muted">Heures / sem.</div>
        </div>
        <div class="card text-center px-3 py-2">
            <div class="fs-4 fw-bold">@creneaux.Select(c => c.GroupeNom).Distinct().Count()</div>
            <div class="small text-muted">Groupe(s)</div>
        </div>
        <div class="ms-auto d-flex gap-2">
            <button class="btn @(viewMode == "grid" ? "btn-success" : "btn-outline-success")" @onclick="ShowGrid">Grille</button>
            <button class="btn @(viewMode == "list" ? "btn-success" : "btn-outline-success")" @onclick="ShowList">Liste</button>
            <button class="btn btn-outline-danger" @onclick="ExportPdf">Exporter en PDF</button>
        </div>
    </div>

    <div id="horaire-print">
        <h4 style="display:none;" class="print-only">Mon emploi du temps</h4>

        @if (viewMode == "grid")
        {
            <div class="table-responsive">
                <table class="table table-bordered mb-0" style="min-width:700px; table-layout:fixed;">
                    <thead>
                        <tr>
                            <th style="width:80px; background:#198754; color:white;">Heure</th>
                            <th style="background:#198754; color:white; text-align:center;">Lundi</th>
                            <th style="background:#198754; color:white; text-align:center;">Mardi</th>
                            <th style="background:#198754; color:white; text-align:center;">Mercredi</th>
                            <th style="background:#198754; color:white; text-align:center;">Jeudi</th>
                            <th style="background:#198754; color:white; text-align:center;">Vendredi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in TimeSlots)
                        {
                            <tr style="height:56px;">
                                <td style="font-size:0.8rem; color:#6c757d; vertical-align:middle; background:#f8f9fa;">@slot</td>
                                @for (int j = 0; j < 5; j++)
                                {
                                    int jour = j;
                                    string s = slot;
                                    var cell = creneaux.FirstOrDefault(c =>
                                        c.JourSemaine == jour &&
                                        string.Compare(c.HeureDebut, s) <= 0 &&
                                        string.Compare(c.HeureFin, s) > 0);

                                    <td style="padding:3px; vertical-align:top;">
                                        @if (cell != null && cell.HeureDebut == slot)
                                        {
                                            <div style="background:#198754;color:white;border-radius:6px;padding:5px 7px;font-size:0.75rem;">
                                                <strong>@cell.CoursNom</strong><br/>
                                                <span class="badge bg-light text-dark">@cell.GroupeNom</span><br/>
                                                <span>@cell.HeureDebut - @cell.HeureFin</span>
                                                @if (cell.Salle != null)
                                                {
                                                    <span> | @cell.Salle</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Jour</th>
                            <th>Cours</th>
                            <th>Groupe</th>
                            <th>Horaire</th>
                            <th>Salle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in creneaux.OrderBy(x => x.JourSemaine).ThenBy(x => x.HeureDebut))
                        {
                            <tr>
                                <td><strong>@JourLabel(c.JourSemaine)</strong></td>
                                <td>@c.CoursNom</td>
                                <td><span class="badge bg-secondary">@c.GroupeNom</span></td>
                                <td>@c.HeureDebut - @c.HeureFin</td>
                                <td>@(c.Salle ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<CreneauDto>? creneaux;
    private string viewMode = "grid";

    private static readonly List<string> TimeSlots = new List<string>
    {
        "07:30","08:00","08:30","09:00","09:30","10:00",
        "10:30","11:00","11:30","12:00","12:30","13:00",
        "13:30","14:00","14:30","15:00","15:30","16:00",
        "16:30","17:00","17:30","18:00","18:30","19:00",
        "19:30","20:00"
    };

    private string JourLabel(int j)
    {
        return j switch { 0 => "Lundi", 1 => "Mardi", 2 => "Mercredi", 3 => "Jeudi", 4 => "Vendredi", _ => "Jour " + j };
    }

    private string TotalHeures
    {
        get
        {
            if (creneaux == null) return "0";
            double total = 0;
            foreach (var c in creneaux)
            {
                if (TimeSpan.TryParse(c.HeureFin, out var fin) && TimeSpan.TryParse(c.HeureDebut, out var debut))
                    total += (fin - debut).TotalHours;
            }
            return total.ToString("0.#") + "h";
        }
    }

    private void ShowGrid() { viewMode = "grid"; }
    private void ShowList() { viewMode = "list"; }
    private async Task ExportPdf() { await JS.InvokeVoidAsync("eval", "window.print()"); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userId = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
            if (!string.IsNullOrEmpty(userId))
            {
                creneaux = await Http.GetFromJsonAsync<List<CreneauDto>>("api/Creneaux/enseignant/" + userId) ?? new();
                StateHasChanged();
            }
        }
    }

    public class CreneauDto
    {
        public int     Id          { get; set; }
        public string  CoursNom    { get; set; } = "";
        public string  GroupeNom   { get; set; } = "";
        public int     JourSemaine { get; set; }
        public string  HeureDebut  { get; set; } = "";
        public string  HeureFin    { get; set; } = "";
        public string? Salle       { get; set; }
    }
}
