Voici EmploiDuTempsEleve.razor complet avec les textes ajustés pour les inscriptions :

@page "/eleve/emploi-du-temps"
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json

<h3>Mon emploi du temps</h3>
<p class="text-muted">Vos créneaux de la semaine selon vos inscriptions.</p>

@if (creneaux == null)
{
    <p>Chargement...</p>
}
else if (!creneaux.Any())
{
    <div class="alert alert-info">Aucun créneau publié pour vos inscriptions pour le moment.</div>
}
else
{
    <div class="d-flex gap-3 mb-3 align-items-center flex-wrap">
        <div class="card text-center px-3 py-2 border-primary">
            <div class="fs-4 fw-bold text-primary">@creneaux.Count</div>
            <div class="small text-muted">Séances</div>
        </div>

        <div class="card text-center px-3 py-2">
            <div class="fs-4 fw-bold">@creneaux.Select(c => c.CoursNom).Distinct().Count()</div>
            <div class="small text-muted">Cours</div>
        </div>

        <div class="ms-auto d-flex gap-2">
            <button class="btn @(viewMode == "grid" ? "btn-primary" : "btn-outline-primary")" @onclick="ShowGrid">
                Grille
            </button>

            <button class="btn @(viewMode == "list" ? "btn-primary" : "btn-outline-primary")" @onclick="ShowList">
                Liste
            </button>

            <button class="btn btn-outline-danger" @onclick="ExportPdf">
                Exporter en PDF
            </button>
        </div>
    </div>

    <div id="horaire-print">
        @if (viewMode == "grid")
        {
            <div class="table-responsive">
                <table class="table table-bordered mb-0" style="min-width:850px; table-layout:fixed;">
                    <thead>
                        <tr>
                            <th style="width:80px; background:#0d6efd; color:white;">Heure</th>
                            <th style="background:#0d6efd; color:white; text-align:center;">Lundi</th>
                            <th style="background:#0d6efd; color:white; text-align:center;">Mardi</th>
                            <th style="background:#0d6efd; color:white; text-align:center;">Mercredi</th>
                            <th style="background:#0d6efd; color:white; text-align:center;">Jeudi</th>
                            <th style="background:#0d6efd; color:white; text-align:center;">Vendredi</th>
                            <th style="background:#0d6efd; color:white; text-align:center;">Samedi</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var slot in TimeSlots)
                        {
                            <tr style="height:56px;">
                                <td style="font-size:0.8rem; color:#6c757d; vertical-align:middle; background:#f8f9fa;">
                                    @slot
                                </td>

                                @for (int j = 0; j < 6; j++)
                                {
                                    int jour = j;
                                    string s = slot;

                                    var cell = creneaux.FirstOrDefault(c =>
                                    c.JourSemaine == JourLabel(jour) &&
                                    string.Compare(c.HeureDebut, s) <= 0 &&
                                    string.Compare(c.HeureFin, s) > 0);

                                    <td style="padding:3px; vertical-align:top;">
                                        @if (cell != null && cell.HeureDebut == slot)
                                        {
                                            <div style="background:#0d6efd;color:white;border-radius:6px;padding:5px 7px;font-size:0.75rem;">
                                                <strong>@cell.CoursNom</strong><br />
                                                <span>@cell.EnseignantNom</span><br />
                                                <span>@cell.HeureDebut - @cell.HeureFin</span>

                                                @if (!string.IsNullOrWhiteSpace(cell.Salle))
                                                {
                                                    <span> | @cell.Salle</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>Jour</th>
                            <th>Cours</th>
                            <th>Enseignant</th>
                            <th>Horaire</th>
                            <th>Salle</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var c in creneaux.OrderBy(x => GetJourIndex(x.JourSemaine)).ThenBy(x => x.HeureDebut))
                        {
                            <tr>
                                <td><strong>@c.JourSemaine</strong></td>
                                <td>@c.CoursNom</td>
                                <td>@c.EnseignantNom</td>
                                <td>@c.HeureDebut - @c.HeureFin</td>
                                <td>@(c.Salle ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<CreneauDto>? creneaux;
    private string viewMode = "grid";

    private static readonly List<string> TimeSlots = new()
    {
        "07:30","08:00","08:30","09:00","09:30","10:00",
        "10:30","11:00","11:30","12:00","12:30","13:00",
        "13:30","14:00","14:30","15:00","15:30","16:00",
        "16:30","17:00","17:30","18:00","18:30","19:00",
        "19:30","20:00"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var eleveId = await JS.InvokeAsync<string>(
                    "localStorage.getItem",
                    "idUtilisateur"
                );

                if (string.IsNullOrEmpty(eleveId))
                {
                    eleveId = await JS.InvokeAsync<string>(
                        "localStorage.getItem",
                        "userId"
                    );
                }

                if (!string.IsNullOrEmpty(eleveId))
                {
                    creneaux = await Http.GetFromJsonAsync<List<CreneauDto>>(
                        $"api/Creneaux/eleve/{eleveId}"
                    ) ?? new();
                }
                else
                {
                    creneaux = new();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
                creneaux = new();
            }

            StateHasChanged();
        }
    }

    private string JourLabel(int j)
    {
        return j switch
        {
            0 => "Lundi",
            1 => "Mardi",
            2 => "Mercredi",
            3 => "Jeudi",
            4 => "Vendredi",
            5 => "Samedi",
            _ => ""
        };
    }

    private int GetJourIndex(string jour)
    {
        return jour switch
        {
            "Lundi" => 0,
            "Mardi" => 1,
            "Mercredi" => 2,
            "Jeudi" => 3,
            "Vendredi" => 4,
            "Samedi" => 5,
            _ => 99
        };
    }

    private void ShowGrid()
    {
        viewMode = "grid";
    }

    private void ShowList()
    {
        viewMode = "list";
    }

    private async Task ExportPdf()
    {
        await JS.InvokeVoidAsync("eval", "window.print()");
    }

    public class CreneauDto
    {
        public int Id { get; set; }
        public string CoursNom { get; set; } = "";
        public string EnseignantNom { get; set; } = "";
        public string JourSemaine { get; set; } = "";
        public string HeureDebut { get; set; } = "";
        public string HeureFin { get; set; } = "";
        public string? Salle { get; set; }
    }
}